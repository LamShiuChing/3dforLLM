# examples/face.py as native engine nodes (step D benchmark): blockout shapes, landmark marks, pinned profile/back
# curves, the OPS strokes, eye and ear. Edits are local (no opaque code node). Absolute placements are the
# blockout and landmark numbers of face.py; step F rebuilds the face through the protocol with relative placements.
new('face')
# --- blockout (face.py base) ---
add('cranium', 'ellipsoid', at=(0, 0.035, -0.005), size=(0.077, 0.082, 0.098))
add('frontal', 'ellipsoid', at=(0, 0.026, 0.05), size=(0.062, 0.05, 0.046), blend=0.02)
add('lower_face', 'ellipsoid', at=(0, -0.055, 0.036), size=(0.054, 0.066, 0.06), blend=0.03)
add('maxilla', 'ellipsoid', at=(0, -0.068, 0.064), size=(0.03, 0.02, 0.032), blend=0.02)
add('lower_lip_mass', 'ellipsoid', at=(0, -0.083, 0.09), size=(0.02, 0.008, 0.01), blend=0.01)
add('chin', 'ellipsoid', at=(0, -0.106, 0.073), size=(0.021, 0.017, 0.02), blend=0.02)
add('jaw', 'capsule', a=(0.038, -0.086, -0.002), b=(0.016, -0.112, 0.074), r=0.01, blend=0.025, mirror=True)
add('cheekbone', 'ellipsoid', at=(0.053, -0.012, 0.042), size=(0.016, 0.014, 0.022), blend=0.02, mirror=True)
add('cheek_pad', 'ellipsoid', at=(0.04, -0.045, 0.054), size=(0.018, 0.02, 0.016), blend=0.02, mirror=True)
add('neck', 'capsule', a=(0, -0.06, -0.008), b=(0, -0.2, -0.005), r=0.054, blend=0.03)
add('nose_blank', 'capsule', a=(0, -0.02, 0.093), b=(0, -0.044, 0.108), r=0.006, r2=0.01, blend=0.01)
add('neck_cut', 'box', at=(0, -0.4, 0), size=(0.5, 0.21, 0.5), op='cut', blend=0.005)
# --- front midline profile (face.py MID) ---
mark('trichion', (0, 0.068, 0.088))
mark('forehead', (0, 0.04, 0.097))
mark('glabella', (0, 0.012, 0.1))
mark('nasion', (0, 0.0, 0.094))
mark('rhinion', (0, -0.022, 0.104))
mark('pronasale', (0, -0.045, 0.12))
mark('columella', (0, -0.05, 0.112))
mark('subnasale', (0, -0.053, 0.101))
mark('labrale_sup', (0, -0.063, 0.105))
mark('stomion', (0, -0.0735, 0.1))
mark('labrale_inf', (0, -0.083, 0.102))
mark('sublabiale', (0, -0.096, 0.092))
mark('pogonion', (0, -0.107, 0.097))
mark('gnathion', (0, -0.116, 0.091))
mark('menton', (0, -0.121, 0.08))
mark('cervical', (0, -0.124, 0.042))
curve('profile', through=['trichion', 'forehead', 'glabella', 'nasion', 'rhinion', 'pronasale', 'columella', 'subnasale', 'labrale_sup', 'stomion', 'labrale_inf', 'sublabiale', 'pogonion', 'gnathion', 'menton', 'cervical'])
# --- back midline (face.py BACK) ---
mark('occiput_upper', (0, 0.093, -0.074))
mark('opisthocranion', (0, 0.03, -0.103))
mark('inion', (0, -0.015, -0.088))
mark('nape', (0, -0.07, -0.06))
mark('neck_back', (0, -0.15, -0.058))
curve('back', through=['occiput_upper', 'opisthocranion', 'inion', 'nape', 'neck_back'])
# --- bilateral landmarks (face.py SIDE), mirrored to _R ---
mark('frontotemporale_L', (0.052, 0.052, 0.078))
mark('eurion_L', (0.077, 0.04, -0.005))
mark('supraorbitale_L', (0.034, 0.015, 0.093))
mark('orbitale_L', (0.033, -0.018, 0.082))
mark('zygion_L', (0.069, -0.012, 0.04))
mark('cheek_L', (0.05, -0.045, 0.072))
mark('alare_L', (0.0175, -0.047, 0.097))
mark('cheilion_L', (0.026, -0.0745, 0.089))
mark('jaw_mid_L', (0.042, -0.105, 0.045))
mark('gonion_L', (0.054, -0.085, -0.002))
# --- strokes (face.py OPS) ---
stroke('nostril', 'carve', along=[(0.0085, -0.0525, 0.103)], amount=(0.0032, 0.0024, 0.0055), width=0.0025, mirror=True)
stroke('alar_wing', 'inflate', along=[(0.015, -0.0475, 0.099)], amount=0.0016, width=0.011, mirror=True)
stroke('alar_groove', 'crease', along=[(0.012, -0.04, 0.104), (0.021, -0.043, 0.098), (0.023, -0.051, 0.096), (0.016, -0.055, 0.099)], amount=0.001, width=0.004, mirror=True)
stroke('nasolabial', 'crease', along=[(0.023, -0.046, 0.094), (0.03, -0.06, 0.09), (0.035, -0.078, 0.082)], amount=0.0012, width=0.009, mirror=True)
stroke('cheek_mass', 'inflate', along=[(0.042, -0.058, 0.082)], amount=0.0015, width=0.016, mirror=True)
stroke('upper_lip', 'ridge', along=[(0.02, -0.07, 0.094), (0, -0.068, 0.103), (-0.02, -0.07, 0.094)], amount=0.0012, width=0.004)
stroke('lower_lip', 'ridge', along=[(0.018, -0.079, 0.094), (0, -0.081, 0.101), (-0.018, -0.079, 0.094)], amount=0.0018, width=0.005)
stroke('vermilion', 'ridge', along=[(0.025, -0.072, 0.09), (0.01, -0.0625, 0.101), (0.004, -0.061, 0.104), (0, -0.0625, 0.105), (-0.004, -0.061, 0.104), (-0.01, -0.0625, 0.101), (-0.025, -0.072, 0.09)], amount=0.0005, width=0.0035)
stroke('mouth_slit', 'groove', along=[(0.026, -0.0745, 0.089), (0.012, -0.0745, 0.097), (0, -0.0735, 0.1), (-0.012, -0.0745, 0.097), (-0.026, -0.0745, 0.089)], amount=0.0009, width=0.0006)
stroke('mouth_corner', 'crease', along=[(0.022, -0.0745, 0.091), (0.029, -0.075, 0.087)], amount=0.0015, width=0.004, mirror=True)
stroke('philtrum', 'crease', along=[(0, -0.054, 0.101), (0, -0.061, 0.104)], amount=0.0006, width=0.009)
stroke('philtral_column', 'ridge', along=[(0.004, -0.054, 0.101), (0.0045, -0.061, 0.104)], amount=0.0004, width=0.003, mirror=True)
stroke('mentolabial', 'crease', along=[(0.015, -0.094, 0.092), (0, -0.096, 0.093), (-0.015, -0.094, 0.092)], amount=0.001, width=0.008)
stroke('chin_pad', 'inflate', along=[(0, -0.107, 0.097)], amount=0.001, width=0.012)
stroke('upper_lid_crease', 'crease', along=[(0.019, 0.004, 0.086), (0.03, 0.01, 0.087), (0.044, 0.007, 0.082)], amount=0.0008, width=0.004, mirror=True)
stroke('brow_ridge', 'ridge', along=[(0.015, 0.014, 0.095), (0.035, 0.017, 0.093), (0.05, 0.012, 0.084)], amount=0.001, width=0.011, mirror=True)
# --- eye and ear (face.py EYE, TRAGION) ---
add('eye', 'eye', center=(0.031, -0.002), r=0.012, en=(0.0165, -0.0015), ex=(0.046, 0.001), up=(0.03, 0.0045), lo=(0.032, -0.006), lid=0.0009)
add('ear', 'ear', tragion=(-0.02, -0.005))
